   Usage: Referenced for the confirmation page shown before a
   category is deleted.
*@

@model RaceDay.Web.Dtos.CategoryResponseDto

@{
    ViewData["Title"] = "Delete category";
    ViewData["BannerTitle"] = "Delete category";
    ViewData["BannerSub"] = Model.CategoryName;
    ViewData["BannerImage"] = "run";
    ViewData["Crumbs"] = new List<(string Text, string? Url)>
    {
        ("Home", Url.Action("Index", "Home")),
        ("Dashboard", Url.Action("Index", "Organiser")),
        ("Categories", Url.Action("Index", "OrganiserCategories", new { eventId = Model.EventId })),
        ("Delete category", null)
    };
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="rd-panel">
            <div class="alert alert-warning">
                Are you sure you want to delete <strong>@Model.CategoryName</strong>
                from <strong>@ViewBag.EventName</strong>?
                This cannot be undone. A category that Participants have
                already enrolled in cannot be deleted.
            </div>

            <form asp-controller="OrganiserCategories" asp-action="Delete" asp-route-eventId="@Model.EventId" asp-route-id="@Model.CategoryId" method="post">
                <button type="submit" class="btn btn-danger">Delete category</button>
                <a asp-controller="OrganiserCategories" asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-link">Cancel</a>
            </form>
        </div>
    </div>
</div>
