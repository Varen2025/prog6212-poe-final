   Usage: Referenced for the category form fields shared by the
   create and edit pages.
*@

@model RaceDay.Web.Models.CategoryFormViewModel

<div class="mb-3">
    <label asp-for="CategoryName" class="form-label"></label>
    <input asp-for="CategoryName" class="form-control" />
    <span asp-validation-for="CategoryName" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CategoryType" class="form-label"></label>
    <select asp-for="CategoryType" class="form-select">
        <option value="Age">Age (age range)</option>
        <option value="Distance">Distance (set distance)</option>
    </select>
    <span asp-validation-for="CategoryType" class="text-danger"></span>
</div>

<div id="ageFields" class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="MinAge" class="form-label"></label>
        <input asp-for="MinAge" type="number" min="0" step="1" class="form-control" />
        <span asp-validation-for="MinAge" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="MaxAge" class="form-label"></label>
        <input asp-for="MaxAge" type="number" min="0" step="1" class="form-control" />
        <span asp-validation-for="MaxAge" class="text-danger"></span>
    </div>
</div>

<div id="distanceFields" class="mb-3">
    <label asp-for="DistanceKm" class="form-label"></label>
    <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
    <span asp-validation-for="DistanceKm" class="text-danger"></span>
</div>

<script>
    // Shows the age fields or the distance field for the chosen type.
    // The server still validates everything.
    (function () {
        var typeSelect = document.getElementById("CategoryType");
        var ageFields = document.getElementById("ageFields");
        var distanceFields = document.getElementById("distanceFields");

        function updateFields() {
            var type = typeSelect.value;
            ageFields.style.display = type === "Age" ? "" : "none";
            distanceFields.style.display = type === "Distance" ? "" : "none";
        }

        typeSelect.addEventListener("change", updateFields);
        updateFields();
    })();
</script>