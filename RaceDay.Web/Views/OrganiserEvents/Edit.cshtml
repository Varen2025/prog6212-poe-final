   replace an event banner image.
*@

@model RaceDay.Web.Models.EventFormViewModel

@{
    ViewData["Title"] = "Edit event";
    ViewData["BannerTitle"] = "Edit event";
    ViewData["BannerSub"] = "Update the details participants see.";
    ViewData["BannerImage"] = "cycle";
    ViewData["Crumbs"] = new List<(string Text, string? Url)>
    {
        ("Home", Url.Action("Index", "Home")),
        ("Dashboard", Url.Action("Index", "Organiser")),
        ("Edit event", null)
    };
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="rd-panel">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <form asp-controller="OrganiserEvents" asp-action="Edit" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
                <input type="hidden" asp-for="CurrentBannerUrl" />

                <partial name="_EventFormFields" model="Model" />

                <div class="mb-3">
                    <label asp-for="BannerImage" class="form-label"></label>

                    @if (!string.IsNullOrEmpty(Model.CurrentBannerUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.CurrentBannerUrl" alt="Current event banner"
                                 class="img-fluid rounded border" style="max-height: 180px;" />
                            <div class="form-text">Current banner. Choose a new image below to replace it.</div>
                        </div>
                    }

                    <input asp-for="BannerImage" type="file" class="form-control"
                           accept="image/jpeg,image/png,image/webp" />
                    <span asp-validation-for="BannerImage" class="text-danger"></span>
                    <div class="form-text">JPG, PNG or WebP, up to 2 MB.</div>
                </div>

                <p class="form-text">
                    Moving an event into the past closes enrolment and allows
                    results to be recorded.
                </p>

                <button type="submit" class="btn btn-primary btn-lg">Save changes</button>
                <a asp-controller="Organiser" asp-action="Index" class="btn btn-link">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
