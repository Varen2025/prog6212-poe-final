@model RaceDay.Web.Models.ResultFormViewModel

@{
    ViewData["Title"] = "Record result";
    ViewData["BannerTitle"] = "Record result";
    ViewData["BannerSub"] = Model.ParticipantName + " · " + Model.CategoryName + " · " + Model.EventName;
    ViewData["BannerImage"] = "finish";
    ViewData["Crumbs"] = new List<(string Text, string? Url)>
    {
        ("Home", Url.Action("Index", "Home")),
        ("Dashboard", Url.Action("Index", "Organiser")),
        ("Results", Url.Action("Index", "OrganiserResults", new { eventId = Model.EventId })),
        ("Record result", null)
    };
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="rd-panel">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <form asp-controller="OrganiserResults" asp-action="Record" asp-route-eventId="@Model.EventId" asp-route-enrolmentId="@Model.EnrolmentId" method="post" novalidate>
                <partial name="_ResultFormFields" model="Model" />

                <button type="submit" class="btn btn-primary btn-lg">Record result</button>
                <a asp-controller="OrganiserResults" asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-link">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
